---
import MainLayout from "@/layouts/MainLayout.astro";
import { loadProductsFromCart } from "@/services/cart/load-products-from-cart";
import { Formatter } from "@/utils/formatter";

let products = [];

try {
  products = await loadProductsFromCart(Astro.cookies);
} catch (error) {
  return Astro.redirect("/");
}

const total = products.reduce(
  (acc, product) => acc + product.price * product.quantity,
  0,
);
---

<MainLayout title="Carrito de compras">
  <h1>Carrito</h1>
  <section class="grid grid-cols-1 sm:grid-cols-2">
    <!-- Productos -->
    <div class="order-2 sm:order-1">
      <h2>Productos</h2>
      <a href="javascript:history.back()" class="text-blue-500 hover:underline"
        >Regresar</a
      >

      {
        products.map((product) => (
          <div class="mt-5 flex gap-5">
            <img src={product.image} alt={product.title} class="h-20 w-20" />

            <div>
              <a href={`/products/${product.slug}`} class="hover:underline">
                {product.title}
              </a>
              <p>${product.price}</p>
              <p>Cantidad: {product.quantity}</p>
              <p>
                Talla: <span class="font-bold">{product.size}</span>
              </p>
              <button
                data-id={product.productId}
                data-size={product.size}
                class="btn-delete text-blue-500"
              >
                Remover
              </button>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Totales -->
    <div class="order-1 h-[330px] rounded-lg bg-black p-6 text-white shadow-lg">
      <h2 class="mb-4 text-lg font-semibold">Resumen de compra</h2>

      <div class="mb-2 flex justify-between text-gray-400">
        <span>Envío</span>
        <span>Gratis</span>
      </div>

      <div class="mb-4 flex justify-between text-gray-400">
        <span>SubTotal </span>
        <span>{Formatter.currency(total)}</span>
      </div>
      <div class="mb-4 flex justify-between text-gray-400">
        <span>Impuesto </span>
        <span>{Formatter.currency(total * 0.15)}</span>
      </div>

      <div class="flex justify-between text-xl font-bold">
        <span>Total</span>
        <span>{Formatter.currency(total * 1.15)}</span>
      </div>

      <button
        class="mt-10 w-full rounded-lg bg-blue-700 py-3 text-gray-300 transition-all hover:bg-gray-600"
      >
        PAGAR
      </button>
    </div>
  </section>
</MainLayout>

<script>
  import { CartCookiesClient } from "@/utils/cart-cookies";

  const deleteButtons = document.querySelectorAll(".btn-delete");

  deleteButtons.forEach((button) => {
    button.addEventListener("click", (event) => {
      const target = event.target as HTMLButtonElement;
      const productId = target.dataset.id ?? "";
      const size = target.dataset.size ?? "";

      CartCookiesClient.removeItem(productId, size);

      // TODO: temporal, se usara viewTransactions
      window.location.reload();
    });
  });
</script>
