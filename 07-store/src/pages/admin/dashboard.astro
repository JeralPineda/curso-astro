---
import ProductImage from "@/components/products/ProductImage.astro";
import Pagination from "@/components/shared/Pagination.astro";
import MainLayout from "@/layouts/MainLayout.astro";
import { getProductsByPage } from "@/services/products/get-products-by-page";
import { Formatter } from "@/utils/formatter";

const searchParams = Astro.url.searchParams;
const pageParam = Number(searchParams.get("page") ?? 1);

const { products, totalPages } = await getProductsByPage(pageParam);

if (products.length === 0) {
  return Astro.redirect(`/?page=${totalPages}`);
}
---


<MainLayout title="Panel administrativo">

  <div class="flex justify-between items-center">
    <div>
      <h1>Dashboard</h1>
      <p>Listado de productos</p>
    </div> 

    <a 
      class="bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded transition-all" 
      href="/admin/products/new"
    >Nuevo Producto</a>
  </div>


  <table class="mt-5 w-full">
    <thead>
      <tr>
        <th class="text-left">Imagen</th>
        <th class="text-left">Titulo</th>
        <th class="text-left">Precio</th>
        <th class="text-left">Inventario</th>
      </tr>
    </thead>

    <tbody>
      {
        products.map((product) => (
          <tr>
        <td>
          <!-- Esto dará error si no hay imágenes -->
          <ProductImage src={product.images[0]} alt={product.title} className="h-16 w-16" />
        </td>
            <td>
              <a
                class="cursor-pointer hover:underline"
                href={`/admin/products/${product.slug}`}
              >
                <!-- data-astro-prefetch="load" -->
                {product.title}
              </a>
            </td>
            <td>{Formatter.currency(product.price)}</td>
            <td>{product.stock}</td>
          </tr>
        ))
      }
    </tbody>
  </table>

  <Pagination totalPages={totalPages} />
</MainLayout>
