---
import { CartCounter } from "../cart/CartCounter";

const { isLoggedIn, isAdmin } = Astro.locals;
---

<nav
  class="fixed top-0 z-10 flex h-20 w-full items-center justify-between px-20 py-10"
  style="background-color: #F9F9F9;"
>
  <h1 class="text-xl font-bold text-gray-800">
    <a href="/">AstroStore</a>
  </h1>

  <div class="flex items-center">
    <ul class="flex items-center space-x-6">
      <CartCounter />

      <li class="font-semibold text-gray-700">
        <a href="/">Home</a>
      </li>

      {
        isAdmin && (
          <li class="font-semibold text-gray-700">
            <a href="/admin/dashboard">Admin</a>
          </li>
        )
      }

      {
        !isLoggedIn ? (
          <li class="font-semibold text-gray-700">
            <a href="/login">Ingresar</a>
          </li>
        ) : (
          <li id="logout" class="font-semibold text-gray-700">
            <a href="#">Salir</a>
          </li>
        )
      }
    </ul>
  </div>
</nav>

<script>
  import { authClient } from "@/lib/auth-client";

  const logoutElem = document.querySelector("#logout") as HTMLLIElement;
  logoutElem?.addEventListener("click", async (e) => {
    e.preventDefault();
    await authClient.signOut();
    window.location.href = "/";
  });
</script>
