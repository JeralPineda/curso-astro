---
interface Props {
  totalPages: number;
}

const { totalPages } = Astro.props;

const url = Astro.url;
const pageParam = Number(url.searchParams.get("page") ?? 1);

const currentPage = Math.max(
  pageParam > totalPages ? totalPages : pageParam,
  1,
);

const path = url.pathname;
---

<div class="my-32 flex justify-between">
  <a class="button" href={`${path}?page=${Math.max(currentPage - 1, 1)}`}>
    Anteriores
  </a>

  <span>Pagina {currentPage} de {totalPages}</span>

  <a
    class="button"
    href={`${path}?page=${Math.min(currentPage + 1, totalPages)}`}
  >
    Siguientes
  </a>
</div>

<style>
  @reference "tailwindcss";

  .button {
    @apply rounded bg-blue-500 p-2 text-white;
  }
</style>
