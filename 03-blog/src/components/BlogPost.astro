---
import type { CollectionEntry } from "astro:content";
import { Formatter } from "@/utils/formatter";
import { Image } from "astro:assets";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { title, description, image, date } = post.data;
---

<div class="lg:flex">
  <Image
    class="h-56 w-full rounded-lg object-cover lg:w-64"
    src={image}
    alt={title}
    width={500}
    height={500}
    quality="low"
    loading="lazy"
    transition:name={`${post.id}-image`}
  />

  <div class="flex flex-col justify-between py-6 lg:mx-6">
    <a
      href={`/posts/${post.id}`}
      class="text-xl font-semibold text-slate-100 hover:underline"
    >
      {description}
    </a>

    <span class="text-sm text-gray-300">{Formatter.formatDate(date)}</span>
  </div>
</div>
