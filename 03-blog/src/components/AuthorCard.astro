---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

interface Props {
  author: CollectionEntry<"author">;
}

const { author } = Astro.props;
const { name, subtitle, avatar, bio, linkedIn, twitter, github } = author.data;
---

<div class="mx-auto my-10 max-w-lg rounded-lg bg-gray-800 p-5 shadow-md">
  <Image
    class="mx-auto h-32 w-32 rounded-full"
    src={avatar}
    alt={name}
    width={200}
    height={200}
  />

  <h2 class="mt-3 text-center text-2xl font-semibold">{name}</h2>
  <p class="mt-1 text-center text-gray-500">{subtitle}</p>

  <div class="mt-5 flex justify-center">
    <a
      href={`https://twitter.com/${twitter}`}
      class="mx-3 text-blue-500 hover:text-blue-700">Twitter</a
    >
    <a href={linkedIn} class="mx-3 text-blue-500 hover:text-blue-700"
      >LinkedIn</a
    >
    <a href={github} class="mx-3 text-blue-500 hover:text-blue-700">GitHub</a>
  </div>

  <div class="mt-5">
    <h3 class="text-xl font-semibold">Bio</h3>
    <p class="mt-2 text-gray-500">
      {bio}
    </p>

    <div class="flex justify-end">
      <a href={`/blog/${author.id}`}>Leer maás</a>
    </div>
  </div>
</div>
