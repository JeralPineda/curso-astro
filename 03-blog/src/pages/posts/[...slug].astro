---
import BlogLayout from "@/layouts/BlogLayout.astro";
import { Formatter } from "@/utils/formatter";
import { Image } from "astro:assets";
import { getEntry } from "astro:content";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;

const { Content, headings } = await render(post);
const author = await getEntry(post.data.author);
---

<BlogLayout frontmatter={post.data}>
  <h1 class="mb-0 text-xs text-gray-500">{post.data.title}</h1>

  <!-- <h4 class="text-md mb-0 text-gray-400">{post.data.author}</h4> -->
  <div class="text-md mt-2 mb-0 flex flex-row text-gray-400">
    <Image
      src={author.data.avatar}
      alt={author.data.name}
      class="rounded-full"
      width={50}
      height={50}
    />

    <div class="ml-5 flex flex-col">
      <a href={`/blog/${post.data.author.id}`}>{author.data.name}</a>
      <span class="text-xs text-gray-200">
        {Formatter.formatDate(post.data.date)}
      </span>
    </div>
  </div>

  <!-- Agregar imagen width(600) y height(220) -->
  <Image
    src={post.data.image}
    alt={post.data.title}
    width={600}
    height={220}
    class="my-5 h-[250px] w-full rounded-md object-cover"
    transition:name={`${post.id}-image`}
  />

  <h3>Tabla de contenidos</h3>
  <ol>
    {
      headings.map((heading, index) => (
        <li>
          <a href={`#${heading.slug}`}>
            {index + 1} - {heading.text}
          </a>
        </li>
      ))
    }
  </ol>

  <Content />

  <div class="my-20">
    <a href="#btn-back">Ir al inicio</a>
  </div>
</BlogLayout>
