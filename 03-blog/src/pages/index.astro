---
import BlogPost from "@/components/BlogPost.astro";
import { siteConfig } from "@/config/site-config";
import MainLayout from "@/layouts/MainLayout.astro";

const posts = Object.values(
  await import.meta.glob("./posts/*.{md,mdx}", { eager: true }),
);
---

<MainLayout title="Jeral's Blog">
  <section class="bg-gray-900">
    <div class="container mx-auto px-6 py-10">
      <h1 class="text-3xl font-semibold text-slate-100 capitalize lg:text-4xl">
        {siteConfig.title}
      </h1>

      <div class="mt-8 grid grid-cols-1 gap-8 md:mt-16 md:grid-cols-2">
        {posts.map((post: any) => <BlogPost {...post} />)}
      </div>
    </div>
  </section>
</MainLayout>
