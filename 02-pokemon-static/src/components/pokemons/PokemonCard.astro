---
interface Props {
  name: string;
  url: string;
  isBig?: boolean;
}

const { name, url, isBig = false } = Astro.props;
const id = url.split("/").at(-2);
const imageSrc = `https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/${id}.png`;
---

<!-- class={`flex flex-col items-center justify-center ${!isBig && "border"} border-slate-500 p-2`} -->
<a
  href={`/pokemons/${name}`}
  class:list={[
    "flex flex-col items-center justify-center border-slate-500 p-2",
    {
      border: !isBig,
    },
  ]}
>
  <img
    class:list={[
      {
        "h-52 w-52": isBig,
        "h-16 w-16": !isBig,
      },
    ]}
    src={imageSrc}
    alt={name}
  />
  <span
    class:list={[
      "capitalize",
      {
        "text-3xl": isBig,
      },
    ]}>#{id} {name}</span
  >
</a>
