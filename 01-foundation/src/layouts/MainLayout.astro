---
import Navbar from "@/components/Navbar.astro";

interface Props {
  title: string;
  name: string;
}

const { title, name } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>

  <body>
    <Navbar />
    <h1>{name}</h1>
    <slot />
  </body>
</html>
