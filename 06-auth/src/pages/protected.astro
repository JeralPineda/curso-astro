---
// import { firebase } from "@/firebase/config";
import MainLayout from "@/layouts/MainLayout.astro";

const { user, isLoggedIn } = Astro.locals;

if (!isLoggedIn || !user) {
  return Astro.redirect("/login");
}

const { name, email, emailVerified, avatar } = user;

// const firebaseUser = firebase.auth.currentUser;
//
// if (!firebaseUser) {
//   return Astro.redirect("/login");
// }
//
// await firebaseUser?.reload(); // Para obtener la información actualizada del usuario
// const { displayName, email, emailVerified, photoURL } = firebaseUser;
//
// const name = displayName ?? "No display name";
---

<MainLayout>
  <div
    class="flex h-[600px] w-full flex-row items-center justify-center rounded-xl bg-gray-200 font-sans"
  >
    <div class="card mx-auto w-96 rounded bg-white shadow-xl hover:shadow">
      {
        avatar ? (
          <img
            class="mx-auto -mt-20 w-32 rounded-full border-8 border-white"
            src={avatar}
            alt={name}
          />
        ) : (
          <div class="mx-auto -mt-20 flex h-32 w-32 items-center justify-center rounded-full border-8 border-white bg-gray-300">
            <span class="text-3xl font-extrabold text-white">
              {name!.substring(0, 2)}
            </span>
          </div>
        )
      }

      <div class="mt-2 text-center text-3xl font-medium">{name}</div>
      <div class="mt-2 text-center text-sm font-light">{email}</div>
      <div class="text-center text-lg font-normal">
        {emailVerified ? "Email verificado" : "Email no verificado"}
      </div>
      <div class="mt-2 px-6 text-center text-sm font-light">
        <p>Front end Developer, avid reader. Love to take a long walk, swim</p>
      </div>
      <hr class="mt-8" />
      <div class="flex p-4">
        <div class="w-1/2 text-center">
          <span class="font-bold">1.8 k</span> Followers
        </div>
        <div class="w-0 border border-gray-300"></div>
        <div class="w-1/2 text-center">
          <span class="font-bold">2.0 k</span> Following
        </div>
      </div>
    </div>
  </div>
</MainLayout>
